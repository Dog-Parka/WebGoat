{
  "family": "webgoat-task",  // ECS에서 관리할 태스크 그룹 이름
  "executionRoleArn": "arn:aws:iam::688567267164:role/ecsTaskExecutionRole",  // ❗ 실제 계정의 역할 ARN
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "webgoat-container",  // ❗ appspec.yaml과 반드시 일치
      "image": "<IMAGE_URI>",       // Jenkins에서 sed로 치환됨
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512"
}
